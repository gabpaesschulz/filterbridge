{
  "name": "@filterbridge/react",
  "version": "0.4.0",
  "description": "React state hook for FilterBridge schemas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "filterbridge",
    "filters",
    "typescript",
    "url-state",
    "search-params",
    "query-params",
    "admin",
    "dashboard",
    "frontend",
    "dx",
    "react",
    "react-hooks"
  ],
  "license": "MIT",
  "author": "Gabriel Paes Schulz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabpaesschulz/filterbridge.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/gabpaesschulz/filterbridge/issues"
  },
  "homepage": "https://github.com/gabpaesschulz/filterbridge#readme",
  "dependencies": {
    "@filterbridge/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@filterbridge/core": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
