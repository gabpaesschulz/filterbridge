{
  "name": "@filterbridge/core",
  "version": "0.3.0",
  "description": "Schema-first filter definitions, parsing, URL serialization and backend DTO generation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "filterbridge",
    "filters",
    "typescript",
    "url-state",
    "search-params",
    "query-params",
    "admin",
    "dashboard",
    "frontend",
    "dx"
  ],
  "license": "MIT",
  "author": "Gabriel Paes Schulz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabpaesschulz/filterbridge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gabpaesschulz/filterbridge/issues"
  },
  "homepage": "https://github.com/gabpaesschulz/filterbridge#readme",
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
